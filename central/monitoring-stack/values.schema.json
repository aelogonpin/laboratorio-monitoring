{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "monitoring-stack",
  "description": "Comprueba que el values del entorno trae lo obligatorio según lo que se active.",
  "type": "object",
  "definitions": {
    "texto": {
      "type": "string",
      "minLength": 1
    },
    "activo": {
      "const": true
    }
  },
  "properties": {
    "global": {
      "type": "object",
      "required": [
        "monitoring",
        "logging",
        "hosts",
        "parameters"
      ],
      "properties": {
        "hosts": {
          "type": "object",
          "properties": {
            "esquema": {
              "enum": [
                "http",
                "https"
              ]
            }
          }
        }
      }
    },
    "ingesta": {
      "type": "object",
      "properties": {
        "clientes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "nombre"
            ],
            "properties": {
              "nombre": {
                "type": "string",
                "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"
              },
              "tenant": {
                "type": "string"
              },
              "ipPermitidas": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[0-9a-fA-F:.]+/[0-9]{1,3}$"
                }
              },
              "senales": {
                "type": "array",
                "items": {
                  "enum": [
                    "logs",
                    "metricas"
                  ]
                }
              },
              "metricasPorCortexTenant": {
                "type": "boolean"
              },
              "cas": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "BEGIN CERTIFICATE"
                }
              }
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "global": {
            "properties": {
              "monitoring": {
                "properties": {
                  "prometheus": {
                    "$ref": "#/definitions/activo"
                  }
                },
                "required": [
                  "prometheus"
                ]
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "global": {
            "properties": {
              "parameters": {
                "required": [
                  "clusterName"
                ],
                "properties": {
                  "clusterName": {
                    "$ref": "#/definitions/texto"
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "global": {
            "properties": {
              "monitoring": {
                "properties": {
                  "mimir": {
                    "$ref": "#/definitions/activo"
                  }
                },
                "required": [
                  "mimir"
                ]
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "global": {
            "required": [
              "kafka"
            ],
            "properties": {
              "kafka": {
                "required": [
                  "bootstrap"
                ],
                "properties": {
                  "bootstrap": {
                    "$ref": "#/definitions/texto"
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "global": {
            "properties": {
              "monitoring": {
                "properties": {
                  "grafana": {
                    "$ref": "#/definitions/activo"
                  }
                },
                "required": [
                  "grafana"
                ]
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "global": {
            "properties": {
              "hosts": {
                "required": [
                  "monitoring"
                ],
                "properties": {
                  "monitoring": {
                    "$ref": "#/definitions/texto"
                  }
                }
              },
              "parameters": {
                "required": [
                  "grafanaClusters"
                ],
                "properties": {
                  "grafanaClusters": {
                    "$ref": "#/definitions/texto"
                  }
                }
              }
            }
          },
          "grafana": {
            "properties": {
              "grafana.ini": {
                "properties": {
                  "database": {
                    "required": [
                      "host"
                    ],
                    "properties": {
                      "host": {
                        "$ref": "#/definitions/texto"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "global": {
            "properties": {
              "monitoring": {
                "properties": {
                  "ingesta": {
                    "$ref": "#/definitions/activo"
                  }
                },
                "required": [
                  "ingesta"
                ]
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "ingesta": {
            "required": [
              "dominio"
            ],
            "properties": {
              "dominio": {
                "$ref": "#/definitions/texto"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "global": {
            "properties": {
              "monitoring": {
                "properties": {
                  "grafana": {
                    "$ref": "#/definitions/activo"
                  }
                },
                "required": [
                  "grafana"
                ]
              }
            }
          },
          "grafana": {
            "properties": {
              "route": {
                "properties": {
                  "main": {
                    "properties": {
                      "enabled": {
                        "$ref": "#/definitions/activo"
                      }
                    },
                    "required": [
                      "enabled"
                    ]
                  }
                },
                "required": [
                  "main"
                ]
              }
            },
            "required": [
              "route"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "grafana": {
            "properties": {
              "route": {
                "properties": {
                  "main": {
                    "properties": {
                      "parentRefs": {
                        "type": "array",
                        "minItems": 1
                      }
                    },
                    "required": [
                      "parentRefs"
                    ]
                  }
                },
                "required": [
                  "main"
                ]
              }
            },
            "required": [
              "route"
            ]
          },
          "global": {
            "properties": {
              "hosts": {
                "required": [
                  "monitoring"
                ],
                "properties": {
                  "monitoring": {
                    "$ref": "#/definitions/texto"
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
