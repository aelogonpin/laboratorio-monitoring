# Single source of truth for the Traefik install.
# When bumping TRAEFIK_CHART_VERSION, set GATEWAY_API_VERSION to the version
# listed in the Traefik docs for that release:
#   docs/content/reference/install-configuration/providers/kubernetes/kubernetes-gateway.md
# then run ./update-crds.sh && ./install.sh

TRAEFIK_CHART_VERSION=42.1.1        # Traefik v3.7.16
GATEWAY_API_VERSION=v1.6.3          # supported by Traefik v3.7.16 (go.mod + docs)
GATEWAY_API_CHANNEL=experimental    # required by providers.kubernetesGateway.experimentalChannel=true (TCPRoute)

NAMESPACE=traefik
RELEASE=traefik
