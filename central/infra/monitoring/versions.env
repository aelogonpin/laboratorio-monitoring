# Versiones fijadas de la base del central del laboratorio (k0s-central).
HELM_BIN=helm                           # helm del PATH
CHART_DIR=../../monitoring-stack        # chart monitoring-stack (rama v2)

PROMETHEUS_OPERATOR_CRDS_VERSION=32.0.1 # = operator v0.94.1 of kube-prometheus-stack 92.10.1 (apply-plan/00-README.md §1.6)
SEAWEEDFS_CHART_VERSION=4.48.0          # local S3 instead of Azure Blob
ARGOCD_CHART_VERSION=10.10.5            # Argo CD v3.5.5 (renders with Helm 4.2.x; chart validated with Helm 4.2.2)
CERT_MANAGER_CHART_VERSION=v1.21.2       # admission webhook certs of kube-prometheus-stack (Argo CD skips Helm hooks)
CNPG_CHART_VERSION=0.29.1                # CloudNativePG 1.30.1, PostgreSQL 18.6 for Grafana (prod: external PostgreSQL >= 12)
